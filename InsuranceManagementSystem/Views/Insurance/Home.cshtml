@{
    ViewData["Title"] = "Home Insurance";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-4"><i class="bi bi-house-door text-warning"></i> Home Insurance</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <h3>What is Home Insurance?</h3>
                    <p>Home insurance protects your house and its contents against damage or theft. It provides financial compensation to repair or rebuild your home and replace damaged belongings.</p>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h3>Key Features</h3>
                    <ul>
                        <li><strong>Building Coverage:</strong> Protection for the structure of your home</li>
                        <li><strong>Contents Coverage:</strong> Protection for household items and belongings</li>
                        <li><strong>Liability Coverage:</strong> Protection against legal liability</li>
                        <li><strong>Additional Living Expenses:</strong> Temporary accommodation costs</li>
                        <li><strong>Natural Disasters:</strong> Coverage for fire, flood, earthquake</li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h3>Coverage Options</h3>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Building Only</h5>
                            <p>Coverage for the structure only</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Comprehensive</h5>
                            <p>Building + Contents coverage</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-body">
                    <h3>What's Covered?</h3>
                    <ul>
                        <li>Fire and smoke damage</li>
                        <li>Theft and burglary</li>
                        <li>Natural calamities (earthquake, flood, storm)</li>
                        <li>Electrical and mechanical breakdown</li>
                        <li>Water damage from burst pipes</li>
                        <li>Vandalism and malicious damage</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-warning text-dark mb-4">
                <div class="card-body">
                    <h4>Get Started</h4>
                    <p>Secure your home and belongings today!</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Calculator" asp-action="Index" class="btn btn-dark w-100 mb-2">Calculate Premium</a>
                        <a asp-controller="Policy" asp-action="Apply" asp-route-type="Home" class="btn btn-outline-dark w-100">Apply Now</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-dark w-100">Register to Apply</a>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h5>Premium Factors</h5>
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-warning"></i> Property Value</li>
                        <li><i class="bi bi-check-circle text-warning"></i> Property Type</li>
                        <li><i class="bi bi-check-circle text-warning"></i> Construction Type</li>
                        <li><i class="bi bi-check-circle text-warning"></i> Property Age</li>
                        <li><i class="bi bi-check-circle text-warning"></i> Security Features</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
