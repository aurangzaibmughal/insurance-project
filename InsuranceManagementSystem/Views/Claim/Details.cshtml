@model Claim
@{
    ViewData["Title"] = "Claim Details";
}

<div class="page-header text-white mb-5">
    <div class="container">
        <h1><i class="bi bi-file-earmark-text"></i> Claim Details</h1>
        <p class="lead">Claim #@Model.ClaimNumber</p>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-lg-8">
            <div class="card glass-card border-0 mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Claim Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Claim Number:</strong>
                            <p>@Model.ClaimNumber</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Status:</strong>
                            <p>
                                <span class="badge bg-@(Model.Status == "Approved" ? "success" : Model.Status == "Rejected" ? "danger" : Model.Status == "Under Review" ? "info" : Model.Status == "Paid" ? "success" : "warning") fs-6">
                                    @Model.Status
                                </span>
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Policy Number:</strong>
                            <p>@Model.Policy?.PolicyNumber</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Policy Type:</strong>
                            <p>@Model.Policy?.PolicyType Insurance</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Claim Type:</strong>
                            <p>@Model.ClaimType</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Claim Amount:</strong>
                            <p class="text-primary fs-5"><strong>$@Model.ClaimAmount.ToString("N2")</strong></p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Incident Date:</strong>
                            <p>@Model.IncidentDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <strong>Claim Filed Date:</strong>
                            <p>@Model.ClaimDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <strong>Description:</strong>
                        <p class="mt-2">@Model.Description</p>
                    </div>

                    @if (Model.ApprovedAmount.HasValue)
                    {
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Approved Amount:</strong>
                                <p class="text-success fs-5"><strong>$@Model.ApprovedAmount.Value.ToString("N2")</strong></p>
                            </div>
                            <div class="col-md-6">
                                <strong>Approval Date:</strong>
                                <p>@Model.ApprovalDate?.ToString("MMMM dd, yyyy")</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.ReviewNotes))
                    {
                        <div class="alert alert-info">
                            <strong><i class="bi bi-chat-left-text"></i> Review Notes:</strong>
                            <p class="mb-0 mt-2">@Model.ReviewNotes</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card glass-card border-0 mb-4">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-list-check"></i> Claim Timeline</h5>
                </div>
                <div class="card-body">
                    <div class="timeline">
                        <div class="timeline-item">
                            <div class="timeline-marker bg-success"></div>
                            <div class="timeline-content">
                                <h6>Claim Submitted</h6>
                                <small class="text-muted">@Model.ClaimDate.ToString("MMM dd, yyyy")</small>
                            </div>
                        </div>

                        @if (Model.ReviewDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <h6>Under Review</h6>
                                    <small class="text-muted">@Model.ReviewDate.Value.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        }

                        @if (Model.ApprovalDate.HasValue)
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-@(Model.Status == "Approved" || Model.Status == "Paid" ? "success" : "danger")"></div>
                                <div class="timeline-content">
                                    <h6>@Model.Status</h6>
                                    <small class="text-muted">@Model.ApprovalDate.Value.ToString("MMM dd, yyyy")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-action="Index" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Back to Claims
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .timeline {
            position: relative;
            padding-left: 30px;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 8px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #dee2e6;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 25px;
        }

        .timeline-marker {
            position: absolute;
            left: -26px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: 0 0 0 2px #dee2e6;
        }

        .timeline-content h6 {
            margin-bottom: 5px;
            font-weight: 600;
        }
    </style>
}
