@model Claim
@{
    ViewData["Title"] = "File New Claim";
    var policies = ViewBag.Policies as List<Policy>;
}

<div class="page-header text-white mb-5">
    <div class="container">
        <h1><i class="bi bi-file-earmark-plus"></i> File New Claim</h1>
        <p class="lead">Submit a claim for your insurance policy</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card glass-card border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label class="form-label">Select Policy</label>
                            <select asp-for="PolicyId" class="form-select" required>
                                <option value="">-- Select a Policy --</option>
                                @if (policies != null)
                                {
                                    @foreach (var policy in policies)
                                    {
                                        <option value="@policy.PolicyId">@policy.PolicyNumber - @policy.PolicyType Insurance</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Claim Type</label>
                            <select asp-for="ClaimType" class="form-select" required>
                                <option value="">-- Select Claim Type --</option>
                                <option value="Accident">Accident</option>
                                <option value="Illness">Illness</option>
                                <option value="Damage">Property Damage</option>
                                <option value="Theft">Theft</option>
                                <option value="Natural Disaster">Natural Disaster</option>
                                <option value="Death">Death Benefit</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Claim Amount ($)</label>
                            <input asp-for="ClaimAmount" type="number" step="0.01" class="form-control" placeholder="Enter claim amount" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Incident Date</label>
                            <input asp-for="IncidentDate" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="Provide detailed description of the incident and claim" required></textarea>
                            <small class="text-muted">Please provide as much detail as possible to help us process your claim quickly.</small>
                        </div>

                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            <strong>Note:</strong> After submitting your claim, our team will review it within 3-5 business days. You will be notified of the status via email.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Submit Claim
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
