@model IEnumerable<Claim>
@{
    ViewData["Title"] = "My Claims";
}

<div class="page-header text-white mb-5">
    <div class="container">
        <h1><i class="bi bi-clipboard-check"></i> My Claims</h1>
        <p class="lead">Track and manage your insurance claims</p>
    </div>
</div>

<div class="container">
    <div class="row mb-4">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> File New Claim
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            @if (Model.Any())
            {
                <div class="card glass-card border-0">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Claim Number</th>
                                        <th>Policy</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Claim Date</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var claim in Model)
                                    {
                                        <tr>
                                            <td><strong>@claim.ClaimNumber</strong></td>
                                            <td>@claim.Policy?.PolicyNumber</td>
                                            <td>@claim.ClaimType</td>
                                            <td>$@claim.ClaimAmount.ToString("N2")</td>
                                            <td>@claim.ClaimDate.ToString("MMM dd, yyyy")</td>
                                            <td>
                                                <span class="badge bg-@(claim.Status == "Approved" ? "success" : claim.Status == "Rejected" ? "danger" : claim.Status == "Under Review" ? "info" : claim.Status == "Paid" ? "success" : "warning")">
                                                    @claim.Status
                                                </span>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card glass-card border-0 text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-clipboard-x" style="font-size: 4rem; color: var(--secondary-color);"></i>
                        <h4 class="mt-3">No Claims Yet</h4>
                        <p class="text-muted">You haven't filed any insurance claims yet.</p>
                        <a asp-action="Create" class="btn btn-primary mt-3">
                            <i class="bi bi-plus-circle"></i> File Your First Claim
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
