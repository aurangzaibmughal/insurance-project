@{
    ViewData["Title"] = "Home";
}

<div class="hero-section text-white">
    <div class="container text-center">
        <h1 class="fade-in-up">Welcome to Insurance Management System</h1>
        <p class="lead">Secure your future with our comprehensive insurance solutions</p>
        <p class="mb-4">Trusted by thousands of customers for over a decade</p>
        <div class="mt-4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Calculator" asp-action="Index" class="btn btn-light btn-lg me-2">
                    <i class="bi bi-calculator"></i> Calculate Premium
                </a>
                <a asp-controller="Policy" asp-action="Apply" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-file-earmark-text"></i> Apply for Policy
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg me-2">
                    <i class="bi bi-person-plus"></i> Get Started
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
            }
        </div>
    </div>
</div>

<div class="container">
    <div class="row text-center mb-5">
        <div class="col-md-3 mb-4">
            <div class="card insurance-card h-100">
                <div class="card-body">
                    <i class="bi bi-heart-pulse text-danger" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Life Insurance</h5>
                    <p class="card-text">Protect your family's financial future with comprehensive life coverage</p>
                    <a asp-controller="Insurance" asp-action="Life" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card insurance-card h-100">
                <div class="card-body">
                    <i class="bi bi-hospital text-success" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Medical Insurance</h5>
                    <p class="card-text">Comprehensive health coverage for you and your family</p>
                    <a asp-controller="Insurance" asp-action="Medical" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card insurance-card h-100">
                <div class="card-body">
                    <i class="bi bi-car-front text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Motor Insurance</h5>
                    <p class="card-text">Complete protection for your vehicle on the road</p>
                    <a asp-controller="Insurance" asp-action="Motor" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card insurance-card h-100">
                <div class="card-body">
                    <i class="bi bi-house-door text-warning" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Home Insurance</h5>
                    <p class="card-text">Safeguard your home and belongings from risks</p>
                    <a asp-controller="Insurance" asp-action="Home" class="btn btn-primary">Learn More</a>
                </div>
            </div>
        </div>
    </div>

    <div class="why-choose-section">
        <div class="container">
            <div class="row mb-5">
                <div class="col-md-12">
                    <h2 class="text-center mb-4">Why Choose Us?</h2>
                    <p class="text-center text-muted mb-5">We provide the best insurance solutions tailored to your needs</p>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon">
                            <i class="bi bi-shield-check" style="font-size: 2.5rem;"></i>
                        </div>
                        <h4 class="mt-3">Trusted & Secure</h4>
                        <p>Your data and policies are protected with industry-leading security measures</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon">
                            <i class="bi bi-clock-history" style="font-size: 2.5rem;"></i>
                        </div>
                        <h4 class="mt-3">Quick Processing</h4>
                        <p>Fast policy approval and claim settlement process within 24-48 hours</p>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="text-center">
                        <div class="feature-icon">
                            <i class="bi bi-headset" style="font-size: 2.5rem;"></i>
                        </div>
                        <h4 class="mt-3">24/7 Support</h4>
                        <p>Our dedicated customer support team is always ready to assist you</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="stats-section">
        <div class="row">
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">10K+</span>
                    <span class="stat-label">Happy Customers</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">15+</span>
                    <span class="stat-label">Years Experience</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">98%</span>
                    <span class="stat-label">Claim Settlement</span>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-item">
                    <span class="stat-number">24/7</span>
                    <span class="stat-label">Customer Support</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row bg-light p-5 rounded">
        <div class="col-md-12 text-center">
            <h2 class="mb-4">Ready to Get Started?</h2>
            <p class="lead mb-4">Join thousands of satisfied customers who trust us with their insurance needs</p>
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-person-plus"></i> Create Account Now
                </a>
            }
            else
            {
                <a asp-controller="Calculator" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-calculator"></i> Calculate Your Premium
                </a>
            }
        </div>
    </div>
</div>
