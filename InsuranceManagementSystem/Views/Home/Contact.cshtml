@{
    ViewData["Title"] = "Contact Us";
}

<div class="contact-hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="contact-hero-title"><i class="bi bi-headset"></i> Get In Touch</h1>
                <p class="contact-hero-subtitle">We're here to help you with all your insurance needs. Our dedicated team is ready to assist you.</p>
            </div>
            <div class="col-lg-6">
                <div class="contact-hero-stats">
                    <div class="contact-stat-item">
                        <i class="bi bi-clock-history"></i>
                        <div>
                            <strong>Response Time</strong>
                            <span>Within 24 Hours</span>
                        </div>
                    </div>
                    <div class="contact-stat-item">
                        <i class="bi bi-people"></i>
                        <div>
                            <strong>Support Team</strong>
                            <span>50+ Experts</span>
                        </div>
                    </div>
                    <div class="contact-stat-item">
                        <i class="bi bi-star-fill"></i>
                        <div>
                            <strong>Satisfaction Rate</strong>
                            <span>98% Happy Clients</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container contact-container">
    <div class="row mb-5">
        <div class="col-md-10 mx-auto text-center">
            <h2 class="section-title">How Can We Help You?</h2>
            <p class="section-subtitle">Choose your preferred way to reach us</p>
        </div>
    </div>

    <div class="row mb-5 contact-methods">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="contact-method-card">
                <div class="contact-method-icon">
                    <i class="bi bi-telephone-fill"></i>
                </div>
                <h5 class="contact-method-title">Call Us</h5>
                <div class="contact-method-content">
                    <div class="contact-detail">
                        <span class="contact-label">Toll Free</span>
                        <a href="tel:1-800-INSURANCE" class="contact-value">1-800-INSURANCE</a>
                    </div>
                    <div class="contact-detail">
                        <span class="contact-label">Direct Line</span>
                        <a href="tel:+12345678900" class="contact-value">+1 234 567 8900</a>
                    </div>
                    <div class="contact-hours">
                        <i class="bi bi-clock"></i> Mon-Fri: 9:00 AM - 6:00 PM
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="contact-method-card">
                <div class="contact-method-icon">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <h5 class="contact-method-title">Email Us</h5>
                <div class="contact-method-content">
                    <div class="contact-detail">
                        <span class="contact-label">General Inquiries</span>
                        <a href="mailto:info@insurance.com" class="contact-value">info@insurance.com</a>
                    </div>
                    <div class="contact-detail">
                        <span class="contact-label">Customer Support</span>
                        <a href="mailto:support@insurance.com" class="contact-value">support@insurance.com</a>
                    </div>
                    <div class="contact-hours">
                        <i class="bi bi-reply-fill"></i> Response within 24 hours
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="contact-method-card">
                <div class="contact-method-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>
                <h5 class="contact-method-title">Visit Us</h5>
                <div class="contact-method-content">
                    <div class="contact-detail">
                        <span class="contact-label">Head Office</span>
                        <p class="contact-value mb-0">
                            123 Insurance Plaza<br>
                            Financial District<br>
                            New York, NY 10004
                        </p>
                    </div>
                    <div class="contact-hours">
                        <i class="bi bi-clock"></i> Mon-Fri: 9:00 AM - 5:00 PM
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="contact-form-wrapper">
                <div class="contact-form-header">
                    <i class="bi bi-chat-dots-fill"></i>
                    <h3>Send Us a Message</h3>
                    <p>Fill out the form below and we'll get back to you as soon as possible</p>
                </div>
                <form class="contact-form">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="form-floating">
                                <input type="text" class="form-control contact-input" id="firstName" placeholder="First Name" required>
                                <label for="firstName"><i class="bi bi-person"></i> First Name</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="form-floating">
                                <input type="text" class="form-control contact-input" id="lastName" placeholder="Last Name" required>
                                <label for="lastName"><i class="bi bi-person"></i> Last Name</label>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="form-floating">
                                <input type="email" class="form-control contact-input" id="email" placeholder="Email Address" required>
                                <label for="email"><i class="bi bi-envelope"></i> Email Address</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="form-floating">
                                <input type="tel" class="form-control contact-input" id="phone" placeholder="Phone Number">
                                <label for="phone"><i class="bi bi-telephone"></i> Phone Number</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-floating">
                            <select class="form-select contact-input" id="subject" required>
                                <option value="">Select a subject...</option>
                                <option value="general">General Inquiry</option>
                                <option value="policy">Policy Information</option>
                                <option value="claim">Claim Support</option>
                                <option value="payment">Payment Issue</option>
                                <option value="feedback">Feedback</option>
                                <option value="other">Other</option>
                            </select>
                            <label for="subject"><i class="bi bi-tag"></i> Subject</label>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-floating">
                            <textarea class="form-control contact-input" id="message" placeholder="Your Message" style="height: 150px" required></textarea>
                            <label for="message"><i class="bi bi-chat-text"></i> Your Message</label>
                        </div>
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn-contact-submit">
                            <span>Send Message</span>
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-10 mx-auto">
            <h3 class="section-title text-center mb-4">Frequently Asked Questions</h3>
            <p class="section-subtitle text-center mb-5">Quick answers to common questions</p>
            <div class="faq-grid">
                <div class="faq-item">
                    <div class="faq-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <div class="faq-content">
                        <h6 class="faq-question">How do I file a claim?</h6>
                        <p class="faq-answer">You can file a claim through your policy dashboard or contact our support team. We process claims within 24-48 hours.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-icon">
                        <i class="bi bi-credit-card"></i>
                    </div>
                    <div class="faq-content">
                        <h6 class="faq-question">What payment methods do you accept?</h6>
                        <p class="faq-answer">We accept credit cards, debit cards, net banking, UPI, and digital wallets for premium payments.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-icon">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div class="faq-content">
                        <h6 class="faq-question">Can I modify my policy?</h6>
                        <p class="faq-answer">Yes, you can request policy modifications by contacting our support team or through your policy dashboard.</p>
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-icon">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="faq-content">
                        <h6 class="faq-question">How long does policy approval take?</h6>
                        <p class="faq-answer">Most policies are approved within 24-48 hours after submission of all required documents.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="contact-emergency-banner">
                <div class="emergency-icon">
                    <i class="bi bi-telephone-forward-fill"></i>
                </div>
                <div class="emergency-content">
                    <h5>Need Immediate Assistance?</h5>
                    <p>For urgent matters or emergencies, our 24/7 helpline is always available</p>
                </div>
                <div class="emergency-action">
                    <a href="tel:1-800-INSURANCE" class="btn-emergency">
                        <i class="bi bi-telephone-fill"></i>
                        1-800-INSURANCE
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
