@{
    ViewData["Title"] = "About Us";
}

<div class="page-header">
    <div class="container">
        <h1><i class="bi bi-info-circle"></i> About Us</h1>
        <p class="lead mb-0">Your trusted partner in insurance solutions</p>
    </div>
</div>

<div class="container">
    <div class="about-section">
        <div class="row mb-5">
            <div class="col-md-6">
                <h2 class="mb-4">Who We Are</h2>
                <p class="lead">Insurance Management System is a leading provider of comprehensive insurance solutions, dedicated to protecting what matters most to you.</p>
                <p>With over 15 years of experience in the insurance industry, we have built a reputation for excellence, reliability, and customer-centric service. Our team of experienced professionals works tirelessly to ensure that you receive the best coverage tailored to your unique needs.</p>
                <p>We understand that choosing the right insurance can be overwhelming. That's why we've created a user-friendly platform that simplifies the entire process—from calculating premiums to managing your policies online.</p>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-lg">
                    <div class="card-body p-4">
                        <h4 class="text-primary mb-4"><i class="bi bi-award"></i> Our Achievements</h4>
                        <ul class="list-unstyled">
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> 10,000+ satisfied customers</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> 98% claim settlement ratio</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> 15+ years of industry experience</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> 24/7 customer support</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-success me-2"></i> Award-winning service excellence</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-6 mb-4">
                <div class="mission-vision-card">
                    <h3><i class="bi bi-bullseye"></i> Our Mission</h3>
                    <p class="mb-0">To provide accessible, affordable, and comprehensive insurance solutions that empower individuals and families to secure their financial future with confidence and peace of mind.</p>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="mission-vision-card">
                    <h3><i class="bi bi-eye"></i> Our Vision</h3>
                    <p class="mb-0">To be the most trusted and innovative insurance provider, recognized for exceptional customer service, transparent practices, and commitment to protecting our customers' dreams and aspirations.</p>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-12">
                <h2 class="text-center mb-5">Our Core Values</h2>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Integrity</h5>
                        <p class="card-text">We operate with honesty and transparency in all our dealings</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Customer First</h5>
                        <p class="card-text">Your needs and satisfaction are our top priority</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-lightbulb text-primary" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Innovation</h5>
                        <p class="card-text">We continuously improve our services and technology</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="card h-100 border-0 shadow">
                    <div class="card-body text-center">
                        <i class="bi bi-heart text-primary" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Excellence</h5>
                        <p class="card-text">We strive for excellence in everything we do</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-12">
                <h2 class="text-center mb-5">Why Choose Us?</h2>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-graph-up text-success"></i> Competitive Premiums</h5>
                        <p class="card-text">We offer some of the most competitive premium rates in the market without compromising on coverage quality.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-lightning text-warning"></i> Quick Processing</h5>
                        <p class="card-text">Our streamlined processes ensure fast policy approval and claim settlements within 24-48 hours.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-laptop text-info"></i> Digital Platform</h5>
                        <p class="card-text">Manage your policies, pay premiums, and track claims—all from our easy-to-use online platform.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card bg-primary text-white border-0 shadow-lg">
                    <div class="card-body text-center p-5">
                        <h3 class="mb-3">Ready to Secure Your Future?</h3>
                        <p class="lead mb-4">Join thousands of satisfied customers who trust us with their insurance needs</p>
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg">
                                <i class="bi bi-person-plus"></i> Get Started Today
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Calculator" asp-action="Index" class="btn btn-light btn-lg">
                                <i class="bi bi-calculator"></i> Calculate Your Premium
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
