@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4"><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-people text-primary" style="font-size: 3rem;"></i>
                    <h3 class="mt-2">@ViewBag.TotalUsers</h3>
                    <p class="text-muted">Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-file-earmark-text text-success" style="font-size: 3rem;"></i>
                    <h3 class="mt-2">@ViewBag.TotalPolicies</h3>
                    <p class="text-muted">Total Policies</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-clock-history text-warning" style="font-size: 3rem;"></i>
                    <h3 class="mt-2">@ViewBag.PendingPolicies</h3>
                    <p class="text-muted">Pending Policies</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <i class="bi bi-currency-rupee text-info" style="font-size: 3rem;"></i>
                    <h3 class="mt-2">₹@ViewBag.TotalRevenue.ToString("N0")</h3>
                    <p class="text-muted">Total Revenue</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <a asp-action="Policies" class="btn btn-outline-primary w-100 mb-2">
                        <i class="bi bi-file-earmark-check"></i> Manage Policies (@ViewBag.PendingPolicies pending)
                    </a>
                    <a asp-action="Loans" class="btn btn-outline-warning w-100 mb-2">
                        <i class="bi bi-cash-coin"></i> Manage Loans (@ViewBag.PendingLoans pending)
                    </a>
                    <a asp-action="Users" class="btn btn-outline-info w-100 mb-2">
                        <i class="bi bi-people"></i> Manage Users
                    </a>
                    <a asp-action="Reports" class="btn btn-outline-success w-100">
                        <i class="bi bi-graph-up"></i> View Reports
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Policy Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <h4 class="text-success">@ViewBag.ApprovedPolicies</h4>
                            <p class="text-muted">Approved</p>
                        </div>
                        <div class="col-6 mb-3">
                            <h4 class="text-warning">@ViewBag.PendingPolicies</h4>
                            <p class="text-muted">Pending</p>
                        </div>
                        <div class="col-6">
                            <h4 class="text-info">@ViewBag.TotalLoans</h4>
                            <p class="text-muted">Total Loans</p>
                        </div>
                        <div class="col-6">
                            <h4 class="text-danger">@ViewBag.PendingLoans</h4>
                            <p class="text-muted">Pending Loans</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info">
        <h5><i class="bi bi-info-circle"></i> Welcome to Admin Panel</h5>
        <p class="mb-0">Use the quick actions above to manage policies, loans, and users. View detailed reports for insights.</p>
    </div>
</div>
